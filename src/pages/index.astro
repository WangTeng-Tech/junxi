---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhyTactile from '../components/WhyTactile.astro';
import TactileDimensions from '../components/TactileDimensions.astro';
import ClosedLoop from '../components/ClosedLoop.astro';
import JunXiXSensor from '../components/JunXiXSensor.astro';
import JunXiGlove from '../components/JunXiGlove.astro';
import OtherSensors from '../components/OtherSensors.astro';
import IotMdmPlatform from '../components/IotMdmPlatform.astro';
import IovOutboundPlatform from '../components/IovOutboundPlatform.astro';
import TeamStrengths from '../components/TeamStrengths.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="知行具身 · 钧曦智能 (JunXiX) | 解锁物理世界的最后一毫米">
  <Header />
  
  <main class="relative z-10">
    <Hero />
    <WhyTactile />
    <TactileDimensions />
    <ClosedLoop />
    <JunXiXSensor />
    <JunXiGlove />
    <OtherSensors />
    <IotMdmPlatform />
    <IovOutboundPlatform />
    <TeamStrengths />
    <ContactSection />
  </main>

  <Footer />
</Layout>
