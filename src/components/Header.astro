---
import { Cpu, ChevronRight, Menu, X } from 'lucide-astro';

const navItems = [
  { name: '理念使命', href: '#about' },
  { name: '触觉感知', href: '#dimensions' },
  { name: '闭环体系', href: '#closed-loop' },
  { 
    name: '商业平台', 
    href: '#iot-platform',
    isAmber: true,
  },
  { name: '团队技术', href: '#team' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#07090E]/85 backdrop-blur-xl border-b border-white/10 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-18 flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-cyan-400/20 via-cyan-500/10 to-amber-500/10 border border-cyan-400/40 flex items-center justify-center group-hover:border-cyan-400 transition-all duration-300 shadow-lg shadow-cyan-500/10">
        <Cpu class="w-4 h-4 sm:w-5 sm:h-5 text-cyan-400 group-hover:scale-110 transition-transform duration-300" />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5 sm:gap-2">
          <span class="font-bold text-base sm:text-lg tracking-tight text-white group-hover:text-cyan-400 transition-colors">钧曦智能</span>
          <span class="text-[10px] sm:text-xs font-mono px-1.5 py-0.2 rounded bg-cyan-400/10 text-cyan-400 border border-cyan-400/30">JunXiX</span>
        </div>
        <span class="text-[9px] sm:text-[10px] text-slate-400 tracking-wider uppercase font-mono hidden xs:inline-block">
          Precision Tactile Intelligence
        </span>
      </div>
    </a>

    <!-- Desktop Navigation (lg 以上屏幕展示，避免 iPad 竖屏文字拥挤) -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-sm font-medium text-slate-300">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`transition-colors py-1 relative group flex items-center gap-1.5 ${
            item.isAmber 
              ? 'hover:text-amber-400' 
              : item.isCyan 
                ? 'hover:text-cyan-400' 
                : 'hover:text-cyan-400'
          }`}
        >
          {item.isAmber && <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>}
          {item.isCyan && <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>}
          <span>{item.name}</span>
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-cyan-400 to-amber-400 group-hover:w-full transition-all duration-300"></span>
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <a 
        href="#contact" 
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 rounded-lg bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs tracking-wide transition-all shadow-lg shadow-cyan-400/20 active:scale-95"
      >
        <span>商务合作</span>
        <ChevronRight class="w-3.5 h-3.5" />
      </a>
      
      <!-- Mobile & Tablet Hamburger Toggle -->
      <button 
        id="mobile-menu-btn" 
        type="button"
        class="lg:hidden p-2 text-slate-300 hover:text-white rounded-lg hover:bg-white/10 border border-white/10 active:bg-white/20 transition-all focus:outline-none focus:ring-2 focus:ring-cyan-400/50"
        aria-label="切换导航菜单"
        aria-expanded="false"
      >
        <Menu id="menu-icon" class="w-5 h-5 block" />
        <X id="close-icon" class="w-5 h-5 hidden text-cyan-400" />
      </button>
    </div>
  </div>

  <!-- Mobile & Vertical Screen Backdrop -->
  <div 
    id="mobile-backdrop" 
    class="hidden fixed inset-0 top-16 sm:top-18 bg-black/70 backdrop-blur-sm z-40 transition-opacity duration-300"
  ></div>

  <!-- Mobile Drawer Menu (支持小屏/折叠屏/超长屏幕平滑滑动) -->
  <div 
    id="mobile-menu" 
    class="hidden lg:hidden fixed top-16 sm:top-18 left-0 right-0 z-50 bg-[#0B0F17]/98 border-b border-cyan-500/20 shadow-2xl max-h-[calc(100vh-4rem)] sm:max-h-[calc(100vh-4.5rem)] overflow-y-auto"
  >
    <div class="px-5 pt-3 pb-8 space-y-1 divide-y divide-white/5">
      
      <!-- Navigation Links -->
      <div class="space-y-1 pb-3">
        {navItems.map((item) => (
          <a 
            href={item.href} 
            class={`mobile-nav-link flex items-center justify-between px-3 py-3 rounded-lg text-sm font-medium transition-all ${
              item.isAmber 
                ? 'text-amber-400 hover:bg-amber-400/10' 
                : item.isCyan 
                  ? 'text-cyan-400 hover:bg-cyan-400/10' 
                  : 'text-slate-200 hover:text-cyan-400 hover:bg-white/5'
            }`}
          >
            <div class="flex items-center gap-2.5">
              {item.isAmber && <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>}
              <span>{item.name}</span>
            </div>
            <ChevronRight class="w-4 h-4 text-slate-500 group-hover:text-cyan-400 transition-colors" />
          </a>
        ))}
      </div>

      <!-- Mobile Footer Action -->
      <div class="pt-4 px-2">
        <a 
          href="#contact" 
          class="mobile-nav-link w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-gradient-to-r from-cyan-400 to-cyan-500 text-slate-950 font-bold text-sm shadow-lg shadow-cyan-400/25 active:scale-98 transition-transform"
        >
          <span>申请样品 / 商务合作</span>
          <ChevronRight class="w-4 h-4" />
        </a>
        <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400 font-mono px-1">
          <span>钧曦智能 · JunXiX</span>
          <span>us@JunXix.xyz</span>
        </div>
      </div>

    </div>
  </div>
</header>

<script>
  function setupMobileNavigation() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-backdrop');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!btn || !menu || !backdrop || !menuIcon || !closeIcon) return;

    function openMenu() {
      menu.classList.remove('hidden');
      backdrop.classList.remove('hidden');
      menuIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden'; // 防止抽屉展开时底层滚动穿透
    }

    function closeMenu() {
      menu.classList.add('hidden');
      backdrop.classList.add('hidden');
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    backdrop.addEventListener('click', () => {
      closeMenu();
    });

    // 点击菜单内任意锚点链接时自动收拢抽屉
    const links = menu.querySelectorAll('.mobile-nav-link');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // 监听 ESC 键关闭
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        closeMenu();
      }
    });

    // 屏幕宽度恢复为大屏时自动重置状态
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && !menu.classList.contains('hidden')) {
        closeMenu();
      }
    });
  }

  // 确保首次加载与 Astro 页面切换时执行绑定
  setupMobileNavigation();
  document.addEventListener('astro:after-swap', setupMobileNavigation);
</script>
