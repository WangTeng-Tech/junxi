---
import { Cpu, Database, Network, ArrowRight } from 'lucide-astro';

const loops = [
  {
    step: '01',
    category: '器件',
    title: '高速视触觉感知',
    icon: Cpu,
    color: 'cyan',
    desc: '自研事件驱动视触觉传感器，在紧凑形态中兼顾低延迟 (1ms)、高带宽、微牛级高精度与多指灵巧手的极致可集成性。'
  },
  {
    step: '02',
    category: '数据',
    title: '人本位采集与仿真',
    icon: Database,
    color: 'amber',
    desc: '以 JunXi Glove 触觉手套和触觉仿真范式，规模化采集并生成真机交互动作数据，配合世界模型扩充高保真训练样本。'
  },
  {
    step: '03',
    category: '模型',
    title: '视觉—触觉—语言—动作',
    icon: Network,
    color: 'emerald',
    desc: '将触觉模态深度融入具身基础模型 (VTLA)，让感知、决策与物理最后一毫米的精细微调形成真实可闭环验证。'
  }
];
---

<section id="closed-loop" class="py-24 bg-dark-900 border-t border-white/5 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 text-xs font-mono text-brand-cyan mb-4">
        <span>DEVICE - DATA - MODEL</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        器件—数据—模型，<span class="text-brand-cyan">一体化闭环</span>
      </h2>
      <p class="text-slate-400 text-base leading-relaxed">
        三层能力自下而上相互增强，共同指向通用精细操作与物理 AGI。
      </p>
    </div>

    <!-- 3-Tier Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {loops.map((item, idx) => (
        <div class="p-8 rounded-2xl bg-dark-850 border border-white/10 hover:border-brand-cyan/40 transition-all flex flex-col justify-between relative group">
          <div>
            <div class="flex items-center justify-between mb-8">
              <span class="text-3xl font-bold font-mono text-white/20 group-hover:text-brand-cyan transition-colors">{item.step}</span>
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-white/5 border border-white/10 text-slate-300">
                {item.category}
              </span>
            </div>
            
            <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-brand-cyan mb-6 group-hover:scale-110 transition-transform">
              <item.icon class="w-7 h-7" />
            </div>

            <h3 class="text-2xl font-bold text-white mb-4">{item.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              {item.desc}
            </p>
          </div>

          <div class="pt-6 border-t border-white/5 flex items-center text-xs font-mono text-slate-400 group-hover:text-brand-cyan transition-colors">
            <span>能力层级强化</span>
            <ArrowRight class="w-4 h-4 ml-auto group-hover:translate-x-1 transition-transform" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
