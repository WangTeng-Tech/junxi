---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const navGroups = [
  {
    title: '硬件与感知',
    links: [
      { name: 'JunXi X 视触觉传感器', href: '#hardware' },
      { name: 'JunXi Glove 触觉手套', href: '#hardware' },
      { name: 'JunXi Hex 六轴力传感器', href: '#hardware' },
      { name: 'JunXi UMI 双手遥操作', href: '#hardware' },
    ],
  },
  {
    title: '闭环与平台',
    links: [
      { name: '器件-数据-模型闭环', href: '#closed-loop' },
      { name: '钧曦物联网 MDM 分销平台', href: '#iot-platform' },
      { name: '钧曦车联网外呼平台', href: '#iov-outbound' },
      { name: '钧曦世界模型仿真器', href: '#hardware' },
    ],
  },
  {
    title: '生态与合作',
    links: [
      { name: '关于钧曦智能', href: '#why-tactile' },
      { name: '团队技术底盘', href: '#team' },
      { name: '商务合作与试用', href: '#contact' },
      { name: '网腾生态门户', href: 'https://wangteng.tech' },
    ],
  },
];
---

<footer class={`bg-[#05070B] border-t border-slate-800/80 pt-16 pb-12 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800/60">
      
      <!-- Brand & Info Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="#" class="flex items-center space-x-3 group inline-block">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-amber-500 p-0.5 shadow-lg shadow-cyan-500/20">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
              <span class="font-mono text-cyan-400 font-bold text-lg">JX</span>
            </div>
          </div>
          <div>
            <div class="font-bold text-lg tracking-wider text-slate-100 group-hover:text-cyan-400 transition-colors">
              钧曦智能 <span class="text-xs text-cyan-400 font-mono font-normal">JunXiX</span>
            </div>
            <div class="text-[11px] text-slate-500 tracking-widest uppercase font-mono">
              PRECISION TACTILE INTELLIGENCE
            </div>
          </div>
        </a>

        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          以高频视触觉传感器与数据底座为切入点，打造器件、数据与模型三层闭环，为机器人通用精细操作提供全栈技术支撑。
        </p>

        <div class="pt-2 space-y-1 text-xs text-slate-400 font-mono">
          <div>总部地址: 北京市朝阳区博睿大厦</div>
          <div>商务洽谈: <a href="mailto:us@JunXix.xyz" class="text-cyan-400 hover:underline">us@JunXix.xyz</a></div>
          <div>服务响应: 7 x 24 小时技术团队对接</div>
        </div>
      </div>

      <!-- Navigation Columns -->
      {navGroups.map((group) => (
        <div class="space-y-3">
          <div class="text-xs font-semibold text-slate-200 uppercase tracking-wider font-mono">
            {group.title}
          </div>
          <ul class="space-y-2">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-400 hover:text-cyan-400 transition-colors"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-400 font-mono gap-4">
      <div>
        Copyright 2026 钧曦智能 (JunXiX). 保留所有权利.
      </div>
      <div class="flex items-center space-x-6 text-slate-400">
        <span>隐私安全规范</span>
        <span>合规协议</span>
        <span>京ICP备XXXXXX号</span>
      </div>
    </div>
  </div>
</footer>
